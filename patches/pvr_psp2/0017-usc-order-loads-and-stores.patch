+static
+IMG_BOOL GetMemAccessRange(PINST psInst, IMG_PUINT32 puFlags, IMG_PUINT32 puLowest, IMG_PUINT32 puHighest)
+/*********************************************************************************
+ Function			: GetMemAccessRange
+
+ Description		: Get the address space flags of an absolute addressed load or
+					  store and, if it doesn't use a dynamic offset, the range of
+					  bytes it accesses relative to its base address.
+
+ Parameters			: psInst		- Load or store.
+					  puFlags		- Returns the UF_MEM_* flags.
+					  puLowest		- Returns the first byte accessed.
+					  puHighest		- Returns the last byte accessed.
+
+ Return				: TRUE if the range is known.
+*********************************************************************************/
+{
+	IMG_UINT32 uDataSize, uCount, uOffset;
+	PARG psOffset = &psInst->asArg[1];
+
+	if (psInst->eOpcode == ILOADMEMCONST)
+	{
+		PARG psDynOffset = &psInst->asArg[LOADMEMCONST_DYNAMIC_OFFSET_ARGINDEX];
+
+		*puFlags = psInst->u.psLoadMemConst->uFlags;
+		if (psInst->u.psLoadMemConst->bRelativeAddress &&
+			!(psDynOffset->uType == USEASM_REGTYPE_IMMEDIATE && psDynOffset->uNumber == 0))
+		{
+			return IMG_FALSE;
+		}
+		uDataSize = psInst->u.psLoadMemConst->uDataSize;
+		uCount = psInst->u.psLoadMemConst->uFetchCount;
+		/* The static offset is in bytes. */
+		uOffset = psOffset->uNumber;
+	}
+	else
+	{
+		switch (psInst->eOpcode)
+		{
+			case ILDAD: case ISTAD: uDataSize = 4; break;
+			case ILDAW: case ISTAW: uDataSize = 2; break;
+			default: uDataSize = 1; break;
+		}
+		*puFlags = psInst->u.psLdSt->uFlags;
+		if (psOffset->uType != USEASM_REGTYPE_IMMEDIATE)
+		{
+			return IMG_FALSE;
+		}
+		uCount = psInst->uRepeat;
+		/* The low word of the offset is scaled by the high word, and a fetch adds the data size. */
+		uOffset = (psOffset->uNumber & 0xFFFF) * (psOffset->uNumber >> 16);
+		if ((g_psInstDesc[psInst->eOpcode].uFlags & DESC_FLAGS_MEMSTORE) == 0 &&
+			GetBit(psInst->auFlag, INST_FETCH))
+		{
+			uOffset += uDataSize;
+		}
+	}
+	*puLowest = uOffset;
+	*puHighest = uOffset + ((uCount > 1) ? uCount : 1) * uDataSize - 1;
+	return IMG_TRUE;
+}
+
+static
+IMG_BOOL MemAccessesMayAlias(PMEMACCESS_DATA psEarlier, PINST psLater)
+/*********************************************************************************
+ Function			: MemAccessesMayAlias
+
+ Description		: Check if two absolute addressed loads or stores might access
+					  the same memory.  They don't if:
+					  1) Either is to memory not aliased by other pointers and the
+					     base addresses are different.
+					  2) The base addresses are the same and the static ranges
+					     don't overlap.
+					  3) They're to different (known) memory address spaces.
+
+ Parameters			: psEarlier		- The earlier load or store.
+					  psLater		- The later one.
+
+ Return				: TRUE if they might.
+*********************************************************************************/
+{
+	PINST psInst = psEarlier->psInst;
+	IMG_UINT32 uFlags, uLaterFlags, uLowest, uHighest, uLaterLowest, uLaterHighest;
+	IMG_BOOL bRange = GetMemAccessRange(psInst, &uFlags, &uLowest, &uHighest);
+	IMG_BOOL bLaterRange = GetMemAccessRange(psLater, &uLaterFlags, &uLaterLowest, &uLaterHighest);
+	IMG_BOOL bSameBase = psInst->asArg[0].uType == psLater->asArg[0].uType &&
+						 psInst->asArg[0].uNumber == psLater->asArg[0].uNumber;
+	IMG_UINT32 uSpace = uFlags & ~UF_MEM_NOALIAS, uLaterSpace = uLaterFlags & ~UF_MEM_NOALIAS;
+
+	if (((uFlags | uLaterFlags) & UF_MEM_NOALIAS) && !bSameBase)
+	{
+		return IMG_FALSE;
+	}
+	if (bSameBase && !psEarlier->bAddressRegChanged && bRange && bLaterRange &&
+		(uHighest < uLaterLowest || uLaterHighest < uLowest))
+	{
+		return IMG_FALSE;
+	}
+	if (uSpace != 0 && uLaterSpace != 0 && uSpace != uLaterSpace)
+	{
+		return IMG_FALSE;
+	}
+	return IMG_TRUE;
+}
