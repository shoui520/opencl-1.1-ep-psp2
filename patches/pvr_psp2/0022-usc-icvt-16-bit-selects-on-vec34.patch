+IMG_INTERNAL
+IMG_VOID AppendMovcI16(PINTERMEDIATE_STATE psState, PCODEBLOCK psBlock, PINST psMovcInst)
+/*****************************************************************************
+ FUNCTION	: AppendMovcI16
+
+ PURPOSE	: Append a MOVC testing a 16-bit integer.  A vector core has no 16-bit
+			  MOVC, so there the test source is shifted into the upper half and
+			  tested with the 32-bit MOVC: its sign and whether it's zero are the
+			  16-bit value's.
+
+ PARAMETERS	: psState			- Compiler state.
+			  psBlock			- Block to append to.
+			  psMovcInst		- IMOVC_I16 instruction, with its arguments set.
+
+ RETURNS	: Nothing.
+*****************************************************************************/
+{
+	#if defined(SUPPORT_SGX543) || defined(SUPPORT_SGX544) || defined(SUPPORT_SGX554)
+	if ((psState->psTargetFeatures->ui32Flags & SGX_FEATURE_FLAGS_USE_VEC34) != 0)
+	{
+		PINST	psShlInst;
+		ARG		sHigh;
+
+		InitInstArg(&sHigh);
+		sHigh.uType = USEASM_REGTYPE_TEMP;
+		sHigh.uNumber = GetNextRegister(psState);
+		sHigh.eFmt = UF_REGFORMAT_F32;
+
+		psShlInst = AllocateInst(psState, psMovcInst);
+		SetOpcode(psState, psShlInst, ISHL);
+		psShlInst->asDest[0] = sHigh;
+		psShlInst->asArg[BITWISE_SHIFTEND_SOURCE] = psMovcInst->asArg[0];
+		psShlInst->asArg[BITWISE_SHIFT_SOURCE].uType = USEASM_REGTYPE_IMMEDIATE;
+		psShlInst->asArg[BITWISE_SHIFT_SOURCE].uNumber = 16;
+		psShlInst->asArg[BITWISE_SHIFT_SOURCE].eFmt = UF_REGFORMAT_F32;
+		AppendInst(psState, psBlock, psShlInst);
+
+		psMovcInst->asArg[0] = sHigh;
+		ModifyOpcode(psState, psMovcInst, IMOVC_I32);
+	}
+	#endif /* defined(SUPPORT_SGX543) || defined(SUPPORT_SGX544) || defined(SUPPORT_SGX554) */
+	AppendInst(psState, psBlock, psMovcInst);
+}
