USC: 8-bit integer MOVCs on vec34

On vec34 cores IMOVC_U8 becomes the packed colour MOVC (IVMOVCU8, with a
C10 destination), which OpenCL's selects, abs and min/max of char and uchar
used on an integer in the low byte of a register: "psIn->asDest[0].eFmt ==
UF_REGFORMAT_U8" in asm.c.  As for 16 bits (AppendMovcI16), the test source
is shifted to the top of the register (by 24) and tested with IMOVC_I32.

diff --git a/tools/intern/usc2/icvt_f32.c b/tools/intern/usc2/icvt_f32.c
index 120eda9..da10dea 100644
--- a/tools/intern/usc2/icvt_f32.c
+++ b/tools/intern/usc2/icvt_f32.c
@@ -2870,7 +2870,8 @@ IMG_VOID ConvertComparisonInstructionF32(PINTERMEDIATE_STATE psState, PCODEBLOCK
 			pfnGetDest(psState, psCodeBlock, &psSrc->sDest, i, &psInst->asDest[0]);
 		}
 
-		if (psInst->eOpcode == IMOVC_I16)
+		if (psInst->eOpcode == IMOVC_I16 ||
+			(psInst->eOpcode == IMOVC_U8 && (psState->uCompilerFlags & UF_OPENCL)))
 		{
 			AppendMovcI16(psState, psCodeBlock, psInst);
 		}
diff --git a/tools/intern/usc2/icvt_i32.c b/tools/intern/usc2/icvt_i32.c
index 80112ba..33e8caa 100644
--- a/tools/intern/usc2/icvt_i32.c
+++ b/tools/intern/usc2/icvt_i32.c
@@ -3047,7 +3047,7 @@ IMG_VOID ConvertMinMaxInstructionInt8(PINTERMEDIATE_STATE	psState,
 	psMovcInst->asArg[2] = *psArgB;
 	
 	/* has already been predicated and had destination set. */
-	AppendInst(psState, psCodeBlock, psMovcInst);
+	AppendMovcI16(psState, psCodeBlock, psMovcInst);
 
 }
 
@@ -4843,7 +4843,7 @@ IMG_VOID IntegerAbsoluteFmt(PINTERMEDIATE_STATE psState,
 	psMovcInst->asArg[0] = *psSrc;
 	psMovcInst->asArg[1] = sNegatedSrc;
 	psMovcInst->asArg[2] = *psSrc;
-	if (eOpCode == IMOVC_I16)
+	if (eOpCode == IMOVC_I16 || eOpCode == IMOVC_U8)
 	{
 		AppendMovcI16(psState, psBlock, psMovcInst);
 	}
@@ -4863,14 +4863,16 @@ IMG_VOID AppendMovcI16(PINTERMEDIATE_STATE psState, PCODEBLOCK psBlock, PINST ps
 /*****************************************************************************
  FUNCTION	: AppendMovcI16
 
- PURPOSE	: Append a MOVC testing a 16-bit integer.  A vector core has no 16-bit
-			  MOVC, so there the test source is shifted into the upper half and
-			  tested with the 32-bit MOVC: its sign and whether it's zero are the
-			  16-bit value's.
+ PURPOSE	: Append a MOVC testing a 16 or 8-bit integer.  A vector core has no
+			  16-bit MOVC, and its 8-bit one is the packed colour MOVC, so there
+			  the test source is shifted into the top of the register and tested
+			  with the 32-bit MOVC: its sign and whether it's zero are the narrow
+			  value's.
 
  PARAMETERS	: psState			- Compiler state.
 			  psBlock			- Block to append to.
-			  psMovcInst		- IMOVC_I16 instruction, with its arguments set.
+			  psMovcInst		- IMOVC_I16, or IMOVC_U8 on an 8-bit integer,
+								  instruction, with its arguments set.
 
  RETURNS	: Nothing.
 *****************************************************************************/
@@ -4891,7 +4893,7 @@ IMG_VOID AppendMovcI16(PINTERMEDIATE_STATE psState, PCODEBLOCK psBlock, PINST ps
 		psShlInst->asDest[0] = sHigh;
 		psShlInst->asArg[BITWISE_SHIFTEND_SOURCE] = psMovcInst->asArg[0];
 		psShlInst->asArg[BITWISE_SHIFT_SOURCE].uType = USEASM_REGTYPE_IMMEDIATE;
-		psShlInst->asArg[BITWISE_SHIFT_SOURCE].uNumber = 16;
+		psShlInst->asArg[BITWISE_SHIFT_SOURCE].uNumber = (psMovcInst->eOpcode == IMOVC_U8) ? 24 : 16;
 		psShlInst->asArg[BITWISE_SHIFT_SOURCE].eFmt = UF_REGFORMAT_F32;
 		AppendInst(psState, psBlock, psShlInst);
 
