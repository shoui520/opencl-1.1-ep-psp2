 /*****************************************************************************
  FUNCTION	: StoreIntoVectorDest
     
- PURPOSE	: 
+ PURPOSE	: Move the scalar results of an instruction's first destination
+			  into its vector register.
 
  PARAMETERS	: psState			- Compiler state.
 			  psCodeBlock		- Block to add the intermediate instructions to.
@@ -2387,16 +2388,41 @@ IMG_VOID StoreIntoVectorDest(PINTERMEDIATE_STATE	psState,
 			  
  RETURNS	: None.
 *****************************************************************************/
+{
+	StoreIntoVectorDestIdx(psState, psCodeBlock, psInputInst, psInputDest, 0 /* uDestIdx */);
+}
+
+IMG_INTERNAL
+IMG_VOID StoreIntoVectorDestIdx(PINTERMEDIATE_STATE	psState,
+								PCODEBLOCK			psCodeBlock,
+								PUNIFLEX_INST		psInputInst,
+								PUF_REGISTER		psInputDest,
+								IMG_UINT32			uDestIdx)
+/*****************************************************************************
+ FUNCTION	: StoreIntoVectorDestIdx
+    
+ PURPOSE	: Move the scalar results of either destination of an instruction
+			  (see GetDestinationTypelessIdx) into its vector register.
+
+ PARAMETERS	: psState			- Compiler state.
+			  psCodeBlock		- Block to add the intermediate instructions to.
+			  psInputInst		- Input instruction to store for.
+			  psInputDest		- Input destination to store into.
+			  uDestIdx			- 0 for the first destination, 1 for the second.
+			  
+ RETURNS	: None.
+*****************************************************************************/
 {
 	PINST		psMkVecInst;
 	IMG_UINT32	uChan;
+	IMG_UINT32	uScalarBase = uDestIdx == 0 ? USC_TEMPREG_VECTEMPDEST : USC_TEMPREG_VECTEMPDEST2;
 
 	psMkVecInst = AllocateInst(psState, NULL);
 
 	SetOpcode(psState, psMkVecInst, IVMOV);
 
-	GetDestinationF32_Vec(psState, &psInputInst->sDest, &psMkVecInst->asDest[0]);
-	psMkVecInst->auDestMask[0] = psInputInst->sDest.u.byMask;
+	GetDestinationF32_Vec(psState, psInputDest, &psMkVecInst->asDest[0]);
+	psMkVecInst->auDestMask[0] = psInputDest->u.byMask;
 
 	GetVectorPredicateInst(psState, psMkVecInst, psInputInst);
 
@@ -2405,7 +2431,7 @@ IMG_VOID StoreIntoVectorDest(PINTERMEDIATE_STATE	psState,
 	for (uChan = 0; uChan < 4; uChan++)
 	{
 		psMkVecInst->asArg[1 + uChan].uType = USEASM_REGTYPE_TEMP;
-		psMkVecInst->asArg[1 + uChan].uNumber = USC_TEMPREG_VECTEMPDEST + uChan;
+		psMkVecInst->asArg[1 + uChan].uNumber = uScalarBase + uChan;
 	}
 
 	psMkVecInst->u.psVec->auSwizzle[0] = USEASM_SWIZZLE(X, Y, Z, W);
