index 5613bb6..0a24ac4 100644
--- a/tools/intern/usc2/icvt_i32.c
+++ b/tools/intern/usc2/icvt_i32.c
@@ -25,6 +25,39 @@
 #include "bitops.h"
 #include <limits.h>
 
+static IMG_VOID GetConstantSource(PINTERMEDIATE_STATE	psState,
+								  IMG_UINT32			uValue,
+								  IMG_PUINT32			puType,
+								  IMG_PUINT32			puNumber)
+/*****************************************************************************
+ FUNCTION	: GetConstantSource
+
+ PURPOSE	: Get a source argument with a constant value: the hardware constant
+			  in the target's numbering (cores with the vector instruction set
+			  number them differently from the EURASIA_USE_SPECIAL_CONSTANT_xxx
+			  values) or, if there isn't one, an immediate.
+
+ PARAMETERS	: psState			- Compiler state.
+			  uValue			- Value of the source.
+			  puType, puNumber	- Returns the argument.
+
+ RETURNS	: Nothing.
+*****************************************************************************/
+{
+	IMG_UINT32	uConst = FindHardwareConstant(psState, uValue);
+
+	if (uConst != USC_UNDEF)
+	{
+		*puType = USEASM_REGTYPE_FPCONSTANT;
+		*puNumber = uConst;
+	}
+	else
+	{
+		*puType = USEASM_REGTYPE_IMMEDIATE;
+		*puNumber = uValue;
+	}
+}
+
