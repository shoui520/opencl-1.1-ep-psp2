+static IMG_BOOL IsMemoryWriteBetween(PINST psBaseInst, PINST psNextInst)
+/*****************************************************************************
+ FUNCTION	: IsMemoryWriteBetween
+
+ PURPOSE	: Check if a store, lock, release or synchronised load between two
+			  memory loads in the same basic block could change the memory read
+			  by whichever of them is later, which a fetch combining them would
+			  read at the position of the earlier one.
+
+ PARAMETERS	: psBaseInst		- The first load in the fetch (with the
+								  loads already combined into it).
+			  psNextInst		- The load to add to the fetch.
+
+ RETURNS	: TRUE if there is one.
+*****************************************************************************/
+{
+	PINST		psInst;
+	PINST		psFirst = psBaseInst;
+	PINST		psLast = psNextInst;
+	IMG_BOOL	bBaseMoves = IMG_FALSE;
+
+	if (psNextInst->uBlockIndex < psBaseInst->uBlockIndex)
+	{
+		psFirst = psNextInst;
+		psLast = psBaseInst;
+		bBaseMoves = IMG_TRUE;
+	}
+	for (psInst = psFirst->psNext; psInst != NULL && psInst != psLast; psInst = psInst->psNext)
+	{
+		if (psInst->eOpcode == ILOCK ||
+			psInst->eOpcode == IRELEASE ||
+			(psInst->eOpcode == ILOADMEMCONST && psInst->u.psLoadMemConst->bSynchronised))
+		{
+			return IMG_TRUE;
+		}
+		if ((g_psInstDesc[psInst->eOpcode].uFlags & DESC_FLAGS_MEMSTORE) != 0)
+		{
+			/*
+				The base instruction may already fetch from several addresses, so
+				moving it is only safe with no store in between at all.
+			*/
+			if (bBaseMoves ||
+				!TestInstructionGroup(psInst->eOpcode, USC_OPT_GROUP_ABS_MEMLDST) ||
+				MemoryAccessesMayAlias(psInst, IMG_FALSE /* bAddressRegChanged */, psNextInst))
+			{
+				return IMG_TRUE;
+			}
+		}
+	}
+	return IMG_FALSE;
+}
+
 IMG_INTERNAL
 IMG_VOID BuildFetchInstructions(PINTERMEDIATE_STATE psState)
 /*****************************************************************************
